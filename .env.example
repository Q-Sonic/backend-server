PORT=3000
NODE_ENV=development

# Firebase (Service Account en Base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Storage bucket name (no gs://). Must match Firebase Console → Storage.
# Old: your-project-id.appspot.com  |  New (Oct 2024+): your-project-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Clave de API web de Firebase (para Login via REST API)
# Firebase Console -> Configuración del proyecto -> General -> Clave de API web
FIREBASE_WEB_API_KEY=

# ─── Verificación por correo (cambio de email / contraseña en cuenta) ────────
# Secreto HMAC para códigos (genera uno aleatorio largo, ej. openssl rand -hex 32)
ACCOUNT_CHANGE_CODE_SECRET=

# Gmail: crea una "Contraseña de aplicaciones" en tu cuenta Google (2FA requerido)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Opcional; si está vacío se usa SMTP_USER
MAIL_FROM=
